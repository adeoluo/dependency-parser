flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>evaluate, parse, serve"]:::edge
        Router["HTTP service<br/>/parse /evaluate"]:::core
        Validate["Validation<br/>form and POS, max 100"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph Train["Training (at startup)"]
        direction TB
        Treebank[("Seeded treebank<br/>400 train, 100 test")]:::data
        Oracle["Static oracle<br/>gold transitions"]:::core
        Trainer["Perceptron training<br/>teacher forcing"]:::core
        Config["TrainingConfig<br/>epochs, seed"]:::control
        Weights[("Averaged weights<br/>feature by action")]:::data
        Config ~~~ Treebank --> Oracle --> Trainer --> Weights
    end

    subgraph Parse["Greedy parsing"]
        direction TB
        Configuration["Configuration<br/>stack, buffer, arcs"]:::core
        Features["Feature templates<br/>stack and buffer"]:::core
        Legal["Legal transitions<br/>apply best, repeat"]:::control
        Configuration --> Features --> Legal
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Response["JSON response<br/>heads and relations"]:::obs
        Eval["Attachment scores<br/>UAS and LAS"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Response ~~~ Eval ~~~ Metrics
    end

    Interfaces -->|train| Train
    Interfaces -->|tokens| Parse
    Train -.->|weights| Parse
    Parse -->|arcs| Obs
    Train -.->|test split| Obs
