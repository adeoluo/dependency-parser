flowchart TD
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    User([CLI user]):::edge
    Client([HTTP client]):::edge

    subgraph Interfaces["Interfaces (CLI and stdlib HTTP)"]
        direction TB
        CLI["cli.py<br/>evaluate | parse | serve"]:::edge
        Router["service.py router<br/>/health /ready /parse /evaluate /metrics"]:::core
        Validate["Request validation<br/>form and pos objects, max 100"]:::control
    end

    subgraph Core["Core logic (arc-standard parser)"]
        direction TB
        Oracle["Static oracle<br/>gold transition sequence"]:::core
        Trainer["parser.py training loop<br/>teacher forcing, shuffled epochs"]:::core
        Configuration["Configuration<br/>stack, buffer, arcs"]:::core
        Features["features.py<br/>stack and buffer templates"]:::core
        Legal["Legal transitions<br/>SHIFT, LEFT, RIGHT"]:::control
    end

    subgraph State["Data and model state (in memory)"]
        direction TB
        Treebank[("data.py<br/>seeded projective treebank")]:::data
        TrainConfig["TrainingConfig<br/>epochs, seed"]:::control
        Weights[("Averaged perceptron<br/>feature by action weights")]:::data
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Eval["evaluation.py<br/>UAS and LAS"]:::obs
        Metrics["ServiceMetrics<br/>Prometheus text"]:::obs
        Response["JSON heads and relations"]:::obs
    end

    User -->|arguments| CLI
    Client -->|JSON request| Router
    Router -->|POST /parse| Validate
    CLI -->|train before use| Trainer
    Treebank -->|train split, 400 trees| Oracle
    Oracle -->|gold transitions| Trainer
    TrainConfig -.-> Trainer
    Features -->|training features| Trainer
    Trainer -->|perceptron updates| Weights
    Validate -->|tokens| Configuration
    CLI -->|form/POS tokens| Configuration
    Configuration -->|context| Features
    Features -->|feature strings| Legal
    Weights -.->|scores| Legal
    Legal -->|argmax transition| Configuration
    Configuration -->|terminal arcs| Response
    Treebank -.->|test split, 100 trees| Eval
    Configuration -->|predicted arcs| Eval
    Router -.->|route latency and errors| Metrics
